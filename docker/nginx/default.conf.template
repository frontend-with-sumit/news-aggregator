# Reverse proxy + static file server (docs/specs/0001-news-api-proxy-architecture.md).
# ${...} tokens are substituted via envsubst at container start; nginx's own $variables
# are left alone. Route-to-key mapping mirrors providerRoutes.ts/vite.proxy.ts.

# Leading '&' before the injected api-key, only when the request already has query params.
map $args $api_key_sep {
    ""      "";
    default "&";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Required because proxy_pass below uses variables, which resolves upstream hosts
    # at request time; 127.0.0.11 is Docker's embedded DNS.
    resolver 127.0.0.11 valid=30s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Query string is built into proxy_pass's URI directly, not via `set $args`: the
    # latter is silently ignored when proxy_pass has no URI part of its own.
    location /api/guardian/ {
        rewrite ^/api/guardian/(.*)$ /$1 break;
        proxy_set_header Host content.guardianapis.com;
        proxy_ssl_server_name on;
        proxy_pass https://content.guardianapis.com$uri?$args${api_key_sep}api-key=${GUARDIAN_API_KEY};
    }

    location /api/nyt/ {
        rewrite ^/api/nyt/(.*)$ /$1 break;
        proxy_set_header Host api.nytimes.com;
        proxy_ssl_server_name on;
        proxy_pass https://api.nytimes.com/svc$uri?$args${api_key_sep}api-key=${NYT_API_KEY};
    }

    # NewsAPI takes its key as a header, not a query parameter.
    location /api/newsapi/ {
        rewrite ^/api/newsapi/(.*)$ /$1 break;
        proxy_set_header Host newsapi.org;
        proxy_ssl_server_name on;
        proxy_set_header X-Api-Key ${NEWSAPI_API_KEY};
        proxy_pass https://newsapi.org/v2$uri?$args;
    }

    location / {
        try_files $uri /index.html;
    }
}
